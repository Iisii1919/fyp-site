test-results/

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# runtime data (questionnaire submissions)
/data/

# --- Stray working/screenshot files: keep locally, do NOT deploy to GitHub/Netlify ---
ref-*.png
reference-style.png
screenshot-*.png
ss-*.png
restore-baseline.ps1
setup-git.ps1
start-dev.bat
dev-server*.log
dev.log
# Scratch helpers in scripts/ stay local, EXCEPT the Apps Script that merges the
# form responses into the analysis table. That one is the research data pipeline
# and existed only on one machine — it must be backed up. (It is also inert on
# the website: nothing in src/ imports it, and Netlify never runs .gs files.)
scripts/*
!scripts/fyp-sheet-merge.gs
